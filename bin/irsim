#!/usr/bin/env node
import { spawn, spawnSync, execFileSync } from 'node:child_process'
import {
  existsSync,
  lstatSync,
  mkdirSync,
  mkdtempSync,
  readFileSync,
  readdirSync,
  realpathSync,
  renameSync,
  rmSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from 'node:fs'
import { connect } from 'node:net'
import { homedir, tmpdir } from 'node:os'
import { basename, dirname, join, resolve } from 'node:path'
import { createInterface } from 'node:readline'
import { fileURLToPath, pathToFileURL } from 'node:url'

const REPO = 'kafbit/irsim'
const CONFIG_FILE = '.irsim.json'
const PORT_MIN = 3200
const PORT_COUNT = 100
const START = '<!-- IRSIM_START -->'
const END = '<!-- IRSIM_END -->'
const RESTART_CODE = 75

const ROOT = resolve(dirname(realpathSync(fileURLToPath(import.meta.url))), '..')
const SERVER = join(ROOT, 'server', 'server.js')
const APP = join(ROOT, 'app')

const HELP = `irsim: design boards for your repository

usage: irsim <command> [options]

commands:
  serve [--design-dir <path>] [--port <n>]   start the canvas (registers new boards in canvas.json first)
  build [--design-dir <path>]                create or update canvas.json from the boards on disk
  export [--design-dir <path>] [--out <dir>] [--title <text>]
                                             build a standalone static preview of the boards
  port                                       print the port serve would use here
  thumbs [--page <id>] [--board <name>] [--force]
                                             queue the board thumbnails on the running canvas
  init [--design-dir <path>] [--refresh-block]
                                             write ${CONFIG_FILE}, ignore .irsim/, add the managed block to AGENTS.md and CLAUDE.md
  update [--check]                           install the latest release (needs gh)
  doctor [--json]                            check the project rules, git setup and config
  bridge <command>                           connect an agent harness to the canvas (bridge --help)
  uninstall [--purge] [--yes] [--dry-run]    remove this install (--purge also removes the cache)
  version                                    print the installed version
  --help                                     print this text
`

const fail = (message, code = 1) => {
  console.error(`irsim: ${message}`)
  process.exit(code)
}

const parse = (args, spec) => {
  const out = { _: [] }
  for (let i = 0; i < args.length; i++) {
    const arg = args[i]
    const [name, inline] = arg.startsWith('--') ? arg.split(/=(.*)/s, 2) : [arg]
    const kind = spec[name]
    if (!kind) {
      if (arg.startsWith('-')) fail(`unknown option ${arg}`, 2)
      out._.push(arg)
    } else if (kind === 'bool') {
      out[name.slice(2)] = true
    } else {
      const value = inline ?? args[++i]
      if (value === undefined || value === '') fail(`${name} needs a value`, 2)
      out[name.slice(2)] = value
    }
  }
  return out
}

const installedVersion = () => {
  for (const file of [join(ROOT, 'VERSION'), join(APP, 'package.json')]) {
    if (!existsSync(file)) continue
    const text = readFileSync(file, 'utf8')
    return file.endsWith('.json') ? JSON.parse(text).version : text.trim()
  }
  return 'unknown'
}

const findConfigDir = (from) => {
  let dir = resolve(from)
  for (;;) {
    if (existsSync(join(dir, CONFIG_FILE))) return dir
    const parent = dirname(dir)
    if (parent === dir) return null
    dir = parent
  }
}

const gitToplevel = (cwd) => {
  try {
    return (
      execFileSync('git', ['rev-parse', '--show-toplevel'], {
        cwd,
        encoding: 'utf8',
        stdio: ['ignore', 'pipe', 'ignore'],
      }).trim() || null
    )
  } catch {
    return null
  }
}

const projectRoot = (cwd) => findConfigDir(cwd) ?? gitToplevel(resolve(cwd)) ?? resolve(cwd)

const resolveDesignDir = (cwd, flag) => {
  if (flag) return resolve(cwd, flag)
  const override = process.env.IRSIM_DESIGN_DIR || process.env.CANVAS_DESIGN_DIR
  if (override) return resolve(cwd, override)
  const configDir = findConfigDir(cwd)
  if (configDir) {
    const value = JSON.parse(readFileSync(join(configDir, CONFIG_FILE), 'utf8'))?.designDir
    return resolve(configDir, typeof value === 'string' && value ? value : 'design')
  }
  const fallback = join(resolve(cwd), 'design')
  if (existsSync(fallback)) return fallback
  fail(
    `no design folder found: pass --design-dir, set IRSIM_DESIGN_DIR or add ${CONFIG_FILE} (irsim init)`,
  )
}

const validPort = (value) => {
  const port = Number(value)
  return Number.isInteger(port) && port >= 1 && port <= 65535 ? port : null
}

const hashPort = (root) => {
  let hash = 0x811c9dc5
  for (const char of root) {
    hash ^= char.codePointAt(0) ?? 0
    hash = Math.imul(hash, 0x01000193) >>> 0
  }
  return PORT_MIN + (hash % PORT_COUNT)
}

const real = (path) => {
  try {
    return realpathSync(path)
  } catch {
    return path
  }
}

const tcpOpen = (port) =>
  new Promise((done) => {
    const socket = connect({ port, host: 'localhost', timeout: 400 })
    socket.once('connect', () => (socket.destroy(), done(true)))
    socket.once('timeout', () => (socket.destroy(), done(true)))
    socket.once('error', () => done(false))
  })

const probePort = async (port) => {
  if (!(await tcpOpen(port))) return { state: 'free' }
  try {
    const response = await fetch(`http://localhost:${port}/api/health`, {
      signal: AbortSignal.timeout(800),
    })
    const body = await response.json()
    if (body.ok === true && typeof body.root === 'string')
      return { state: 'canvas', root: body.root }
  } catch {
    return { state: 'busy' }
  }
  return { state: 'busy' }
}

const portFile = (root) => join(root, '.irsim', 'port')

const readRecorded = (root) => {
  try {
    return validPort(readFileSync(portFile(root), 'utf8').trim())
  } catch {
    return null
  }
}

const canvasPort = async (root) => {
  const recorded = readRecorded(root)
  const forced = validPort(process.env.IRSIM_PORT || process.env.DESIGN_PORT)
  if (forced !== null) return { port: forced, serving: false }
  const start = hashPort(root)
  const candidates = [
    ...(recorded ? [recorded] : []),
    ...Array.from({ length: PORT_COUNT }, (_, step) => PORT_MIN + ((start - PORT_MIN + step) % PORT_COUNT)),
  ]
  for (const port of new Set(candidates)) {
    const found = await probePort(port)
    const mine = found.state === 'canvas' && real(found.root) === real(root)
    if (found.state === 'free' || mine) {
      if (port !== recorded) {
        mkdirSync(dirname(portFile(root)), { recursive: true })
        writeFileSync(portFile(root), `${port}\n`)
      }
      return { port, serving: mine }
    }
  }
  fail(`no free canvas port in ${PORT_MIN}..${PORT_MIN + PORT_COUNT - 1}`)
}

const thumbs = async (args) => {
  const opts = parse(args, { '--page': 'value', '--board': 'value', '--force': 'bool' })
  const { port, serving } = await canvasPort(projectRoot(process.cwd()))
  if (!serving && (await probePort(port)).state !== 'canvas')
    fail('the server is not running, start it with irsim serve')
  const body = {
    ...(opts.page ? { page: opts.page } : {}),
    ...(opts.board ? { board: opts.board } : {}),
    ...(opts.force ? { force: true } : {}),
  }
  let response
  try {
    response = await fetch(`http://localhost:${port}/api/thumbs`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    })
  } catch {
    fail('the server is not running, start it with irsim serve')
  }
  const result = await response.json().catch(() => ({}))
  if (!response.ok) fail(result.error ?? `the server answered ${response.status}`)
  console.log(`irsim: queued ${result.queued}, present ${result.present}, failed ${result.failed}`)
}

const loadBuildCanvas = () => import(pathToFileURL(join(ROOT, 'bin', 'lib', 'build-canvas.mjs')).href)

const build = async (args) => {
  const opts = parse(args, { '--design-dir': 'value' })
  const design = resolveDesignDir(process.cwd(), opts['design-dir'])
  const { buildCanvas } = await loadBuildCanvas()
  try {
    const result = buildCanvas(design)
    console.log(`wrote ${result.file}: ${result.pages} pages, ${result.boards} boards`)
  } catch (error) {
    fail(error.message)
  }
}

const loadExportSite = () =>
  import(pathToFileURL(join(ROOT, 'bin', 'lib', 'export-site.mjs')).href)

const runtimeDir = () => {
  for (const candidate of [
    join(ROOT, 'app', 'public', 'runtime'),
    join(ROOT, 'server', 'public', 'runtime'),
  ]) {
    if (existsSync(join(candidate, 'support.js'))) return candidate
  }
  fail('no board runtime found in this install')
}

const exportSite = async (args) => {
  const opts = parse(args, { '--design-dir': 'value', '--out': 'value', '--title': 'value' })
  const design = resolveDesignDir(process.cwd(), opts['design-dir'])
  const out = resolve(process.cwd(), opts.out ?? join('dist', 'preview'))
  const { exportSite: run } = await loadExportSite()
  try {
    const result = run({
      designDir: design,
      outDir: out,
      runtimeDir: runtimeDir(),
      title: opts.title ?? 'irsim preview',
    })
    console.log(`wrote ${result.outDir}: ${result.pages} pages, ${result.boards} boards`)
    console.log(`open ${join(result.outDir, 'index.html')} through a static server, not file://`)
    for (const problem of result.missing) console.warn(`irsim: ${problem}`)
  } catch (error) {
    fail(error.message)
  }
}

const register = async (design) => {
  if (!existsSync(design)) return
  try {
    const { buildCanvas, needsRegistration } = await loadBuildCanvas()
    if (!needsRegistration(design)) return
    const result = buildCanvas(design)
    console.log(`irsim: registered boards in ${result.file} (${result.pages} pages, ${result.boards} boards)`)
  } catch (error) {
    console.error(`irsim: could not update canvas.json: ${error.message}`)
  }
}

const buildStamp = () => {
  const f = join(ROOT, 'BUILD')
  return existsSync(f) ? readFileSync(f, 'utf8').trim() || null : null
}

const fetchBuild = async (port) => {
  try {
    const response = await fetch(`http://localhost:${port}/api/version?latest=0`, {
      signal: AbortSignal.timeout(1500),
    })
    if (!response.ok) return undefined
    const body = await response.json()
    return body.build ?? null
  } catch {
    return undefined
  }
}

const restartRunning = async (port, url, stamp) => {
  const running = await fetchBuild(port)
  if (running === undefined || running === stamp) return false
  let response
  try {
    response = await fetch(`http://localhost:${port}/api/restart`, {
      method: 'POST',
      signal: AbortSignal.timeout(5000),
    })
  } catch {
    return false
  }
  if (response.status === 409 || response.status === 404) {
    console.log(`irsim: ${url} runs an older build, stop it and run irsim serve again`)
    return true
  }
  if (response.status !== 202) return false
  console.log(`irsim: ${url} (restarting on the new build)`)
  const deadline = Date.now() + 30_000
  while (Date.now() < deadline) {
    await new Promise((done) => setTimeout(done, 500))
    if ((await fetchBuild(port)) === stamp) {
      console.log(`irsim: ${url} (running the new build)`)
      return true
    }
  }
  console.log('irsim: the canvas did not come back on the new build, stop it and run irsim serve')
  return true
}

const serve = async (args) => {
  const opts = parse(args, { '--design-dir': 'value', '--port': 'value' })
  const cwd = process.cwd()
  const root = projectRoot(cwd)
  const design = resolveDesignDir(cwd, opts['design-dir'])
  const prefix = prefixOf()
  let port
  let serving = false
  if (opts.port !== undefined) {
    port = validPort(opts.port)
    if (port === null) fail(`invalid port ${opts.port}`, 2)
    serving = (await probePort(port)).state === 'canvas'
  } else {
    ;({ port, serving } = await canvasPort(root))
  }
  const url = `http://localhost:${port}`
  if (serving) {
    const stamp = buildStamp()
    if (stamp !== null && (await restartRunning(port, url, stamp))) return
    console.log(`irsim: ${url} (already running)`)
    return
  }
  await register(design)
  const env = {
    ...process.env,
    IRSIM_DESIGN_DIR: design,
    IRSIM_ROOT: root,
    PORT: String(port),
    HOSTNAME: '127.0.0.1',
    IRSIM_VERSION: installedVersion(),
    IRSIM_BUILD: buildStamp() ?? '',
    IRSIM_LAUNCHER: join(ROOT, 'bin', 'irsim'),
    IRSIM_PREFIX: prefix ?? '',
  }
  let command
  let argv
  let childCwd
  if (existsSync(SERVER)) {
    command = process.execPath
    argv = [SERVER]
    childCwd = dirname(SERVER)
  } else if (existsSync(join(APP, 'package.json'))) {
    const next = join(APP, 'node_modules', '.bin', 'next')
    if (!existsSync(next)) fail(`run bun install in ${APP} first`)
    command = next
    argv = ['dev', '--port', String(port)]
    childCwd = APP
  } else {
    fail(`no server found in ${ROOT}`)
  }
  console.log(`irsim: ${url}`)
  const child = spawn(command, argv, { cwd: childCwd, env, stdio: 'inherit' })
  let active = child
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP'])
    process.on(signal, () => active.kill(signal))
  child.on('error', (error) => {
    console.error(`irsim: could not start the server: ${error.message}`)
    process.exit(1)
  })
  let pidFile = prefix && child.pid ? join(ROOT, '.pids', String(child.pid)) : null
  if (pidFile) {
    try {
      mkdirSync(dirname(pidFile), { recursive: true })
      writeFileSync(pidFile, '')
    } catch {
      pidFile = null
    }
  }
  const relaunch = () => {
    const next = spawn(join(prefix, 'current', 'bin', 'irsim'), ['serve', ...args], {
      cwd: process.cwd(),
      env: { ...process.env, IRSIM_RELAUNCHED: '1' },
      stdio: 'inherit',
    })
    active = next
    next.on('error', (error) => {
      console.error(`irsim: could not restart: ${error.message}`)
      process.exit(1)
    })
    next.on('exit', (nextCode, nextSignal) => {
      if (nextCode === RESTART_CODE) relaunch()
      else process.exit(nextCode ?? (nextSignal ? 1 : 0))
    })
  }
  child.on('exit', (code, signal) => {
    if (pidFile) rmSync(pidFile, { force: true })
    if (code === RESTART_CODE && prefix) {
      if (process.env.IRSIM_RELAUNCHED === '1') process.exit(RESTART_CODE)
      relaunch()
      return
    }
    process.exit(code ?? (signal ? 1 : 0))
  })
}

const block = () => {
  const file = join(ROOT, 'templates', 'agents-block.md')
  if (!existsSync(file)) fail(`missing template ${file}`)
  return `${readFileSync(file, 'utf8').trim()}\n`
}

const withBlock = (text, managed, replaceOnly) => {
  const start = text.indexOf(START)
  const end = text.indexOf(END, start + 1)
  if (start !== -1 && end !== -1)
    return text.slice(0, start) + managed.trimEnd() + text.slice(end + END.length)
  if (replaceOnly) return text
  const body = text.replace(/\s+$/, '')
  return `${body}${body ? '\n\n' : ''}${managed}`
}

const init = (args) => {
  const opts = parse(args, { '--design-dir': 'value', '--refresh-block': 'bool' })
  const dir = process.cwd()
  const refreshOnly = opts['refresh-block'] === true
  if (!refreshOnly) {
    const config = join(dir, CONFIG_FILE)
    if (existsSync(config)) {
      console.log(`${CONFIG_FILE}: kept`)
    } else {
      const designDir = opts['design-dir'] ?? 'design'
      writeFileSync(config, `${JSON.stringify({ designDir }, null, 2)}\n`)
      console.log(`${CONFIG_FILE}: created (designDir ${designDir})`)
    }
    const ignore = join(dir, '.gitignore')
    const current = existsSync(ignore) ? readFileSync(ignore, 'utf8') : ''
    if (current.split(/\r?\n/).some((line) => line.trim() === '.irsim/' || line.trim() === '.irsim')) {
      console.log('.gitignore: kept')
    } else {
      const separator = current && !current.endsWith('\n') ? '\n' : ''
      writeFileSync(ignore, `${current}${separator}.irsim/\n`)
      console.log('.gitignore: added .irsim/')
    }
  }
  const managed = block()
  for (const name of ['AGENTS.md', 'CLAUDE.md']) {
    const file = join(dir, name)
    if (!existsSync(file)) continue
    const before = readFileSync(file, 'utf8')
    const after = withBlock(before, managed, refreshOnly)
    if (after === before) {
      console.log(`${name}: unchanged`)
    } else {
      writeFileSync(file, after)
      console.log(`${name}: block ${before.includes(START) ? 'refreshed' : 'added'}`)
    }
  }
}

const platformTag = () => {
  const os = { linux: 'linux', darwin: 'darwin' }[process.platform]
  const arch = { x64: 'x64', arm64: 'arm64' }[process.arch]
  if (!os || !arch) fail(`no release for ${process.platform}-${process.arch}`)
  return `${os}-${arch}`
}

const gh = (args, options = {}) => {
  const result = spawnSync('gh', args, { encoding: 'utf8', ...options })
  if (result.error) fail('gh is not installed or not on PATH')
  if (result.status !== 0)
    fail(`gh ${args.slice(0, 2).join(' ')} failed: ${(result.stderr || '').trim() || result.status}`)
  return (result.stdout || '').trim()
}

const newer = (a, b) => {
  const split = (v) => {
    const [base] = v.split('+')
    const dash = base.indexOf('-')
    const core = (dash === -1 ? base : base.slice(0, dash)).split('.').map((n) => Number.parseInt(n, 10) || 0)
    const pre = dash === -1 ? null : base.slice(dash + 1).split('.')
    return { core, pre }
  }
  const [x, y] = [split(a), split(b)]
  for (let i = 0; i < Math.max(x.core.length, y.core.length); i++) {
    const d = (x.core[i] ?? 0) - (y.core[i] ?? 0)
    if (d !== 0) return d > 0
  }
  if (!x.pre || !y.pre) return !x.pre && Boolean(y.pre)
  const numeric = (id) => /^\d+$/.test(id)
  for (let i = 0; i < Math.min(x.pre.length, y.pre.length); i++) {
    const [p, q] = [x.pre[i], y.pre[i]]
    if (p === q) continue
    if (numeric(p) && numeric(q)) return Number(p) > Number(q)
    if (numeric(p)) return false
    if (numeric(q)) return true
    return p > q
  }
  return x.pre.length > y.pre.length
}

const prefixOf = () => {
  const prefix = dirname(ROOT)
  const current = join(prefix, 'current')
  try {
    if (lstatSync(current).isSymbolicLink() && real(current) === ROOT) return prefix
  } catch {}
  return null
}

const pidAlive = (pid) => {
  try {
    process.kill(pid, 0)
    return true
  } catch (error) {
    return error?.code === 'EPERM'
  }
}

const hasLiveServer = (dir) => {
  const pids = join(dir, '.pids')
  let alive = false
  let names
  try {
    names = readdirSync(pids)
  } catch {
    return false
  }
  for (const name of names) {
    const pid = Number(name)
    if (Number.isInteger(pid) && pid > 0 && pidAlive(pid)) alive = true
    else rmSync(join(pids, name), { force: true })
  }
  return alive
}

const acquireLock = (prefix) => {
  const lockDir = join(prefix, '.update.lock')
  for (let attempt = 0; ; attempt++) {
    try {
      mkdirSync(lockDir)
      writeFileSync(join(lockDir, 'pid'), String(process.pid))
      break
    } catch (error) {
      if (error?.code !== 'EEXIST') throw error
      let pid = 0
      try {
        pid = Number.parseInt(readFileSync(join(lockDir, 'pid'), 'utf8'), 10)
      } catch {}
      if (Number.isInteger(pid) && pid > 0 && pidAlive(pid)) fail(`another update is running (pid ${pid})`)
      if (attempt > 0) fail(`could not take ${lockDir}`)
      rmSync(lockDir, { recursive: true, force: true })
    }
  }
  let released = false
  const release = () => {
    if (released) return
    released = true
    rmSync(lockDir, { recursive: true, force: true })
  }
  process.on('exit', release)
  return release
}

const writeProgress = (prefix, payload) => {
  const dir = join(prefix, '.update.lock')
  const temporary = join(dir, `progress.${process.pid}.tmp`)
  try {
    writeFileSync(temporary, JSON.stringify(payload))
    renameSync(temporary, join(dir, 'progress.json'))
  } catch {}
}

const downloadAsset = (prefix, tag, asset, work, total) =>
  new Promise((resolve) => {
    const args = ['release', 'download', tag, '--repo', REPO, '--pattern', asset, '--dir', work]
    const child = spawn('gh', args, { stdio: ['ignore', 'ignore', 'pipe'] })
    let stderr = ''
    child.stderr.on('data', (chunk) => {
      stderr += chunk
    })
    const tick = () => {
      let received = 0
      try {
        received = statSync(join(work, asset)).size
      } catch {}
      writeProgress(prefix, { stage: 'download', received, total })
    }
    tick()
    const timer = setInterval(tick, 250)
    child.on('error', () => {
      clearInterval(timer)
      fail('gh is not installed or not on PATH')
    })
    child.on('close', (status) => {
      clearInterval(timer)
      if (status !== 0) fail(`gh ${args.slice(0, 2).join(' ')} failed: ${stderr.trim() || status}`)
      resolve()
    })
  })

const update = async (args) => {
  const opts = parse(args, { '--check': 'bool' })
  const installed = installedVersion()
  const tag = gh(['release', 'view', '--repo', REPO, '--json', 'tagName', '--jq', '.tagName'])
  const latest = tag.replace(/^v/, '')
  console.log(`installed: ${installed}`)
  console.log(`latest:    ${latest}`)
  if (!newer(latest, installed)) {
    console.log('irsim is up to date')
    return
  }
  if (opts.check) {
    console.log(`update available: run irsim update`)
    return
  }
  const prefix = prefixOf()
  if (!prefix) fail(`${ROOT} is not a release install, reinstall with install.sh`)
  const release = acquireLock(prefix)
  try {
    const active = (() => {
      try {
        return basename(real(join(prefix, 'current')))
      } catch {
        return installed
      }
    })()
    if (!newer(latest, active)) {
      console.log('irsim is up to date')
      return
    }
    const asset = `irsim-${latest}-${platformTag()}.tar.gz`
    const work = mkdtempSync(join(tmpdir(), 'irsim-update-'))
    try {
      const lookup = spawnSync(
        'gh',
        [
          'release',
          'view',
          tag,
          '--repo',
          REPO,
          '--json',
          'assets',
          '--jq',
          `.assets[] | select(.name=="${asset}") | .size`,
        ],
        { encoding: 'utf8' },
      )
      const size = lookup.error || lookup.status !== 0 ? 0 : Number(String(lookup.stdout).trim())
      await downloadAsset(prefix, tag, asset, work, Number.isFinite(size) && size > 0 ? size : 0)
      writeProgress(prefix, { stage: 'install' })
      const target = join(prefix, latest)
      const staging = `${target}.partial`
      rmSync(staging, { recursive: true, force: true })
      mkdirSync(staging, { recursive: true })
      const untar = spawnSync('tar', ['-xzf', join(work, asset), '-C', staging, '--strip-components=1'], {
        stdio: 'inherit',
      })
      if (untar.status !== 0) fail('could not extract the release archive')
      rmSync(target, { recursive: true, force: true })
      renameSync(staging, target)
      const link = join(prefix, '.current.new')
      rmSync(link, { force: true })
      symlinkSync(latest, link)
      renameSync(link, join(prefix, 'current'))
      for (const entry of readdirSync(prefix)) {
        if (
          /^\d+\.\d+\.\d+/.test(entry) &&
          entry !== latest &&
          entry !== basename(ROOT) &&
          !hasLiveServer(join(prefix, entry))
        )
          rmSync(join(prefix, entry), { recursive: true, force: true })
      }
      console.log(`updated to ${latest}`)
    } finally {
      rmSync(work, { recursive: true, force: true })
    }
  } finally {
    release()
  }
  const project = findConfigDir(process.cwd())
  if (project) {
    spawnSync(join(prefix, 'current', 'bin', 'irsim'), ['init', '--refresh-block'], {
      cwd: project,
      stdio: 'inherit',
    })
  }
}

const doctor = async (args) => {
  const opts = parse(args, { '--json': 'bool' })
  const { formatDoctor, runDoctor } = await import(
    pathToFileURL(join(ROOT, 'bin', 'lib', 'doctor.mjs')).href
  )
  const report = await runDoctor({
    cwd: projectRoot(process.cwd()),
    env: { ...process.env, IRSIM_ROOT: projectRoot(process.cwd()) },
  })
  if (opts.json) console.log(JSON.stringify(report, null, 2))
  else console.log(formatDoctor(report))
  if (!report.ok) process.exit(1)
}

const confirm = (question) =>
  new Promise((done) => {
    const rl = createInterface({ input: process.stdin, output: process.stdout })
    rl.question(question, (answer) => {
      rl.close()
      done(/^y(es)?$/i.test(answer.trim()))
    })
  })

const uninstall = async (args) => {
  const opts = parse(args, { '--purge': 'bool', '--yes': 'bool', '--dry-run': 'bool' })
  const prefix = prefixOf()
  if (!prefix) fail(`${ROOT} is not a release install, nothing to uninstall`)
  const targets = [prefix]
  const binLink = join(homedir(), '.local', 'bin', 'irsim')
  try {
    if (lstatSync(binLink).isSymbolicLink() && real(binLink).startsWith(`${prefix}/`)) targets.push(binLink)
  } catch {}
  if (opts.purge)
    targets.push(
      process.env.IRSIM_CACHE_DIR || join(process.env.XDG_CACHE_HOME || join(homedir(), '.cache'), 'irsim'),
    )
  for (const target of targets) console.log(`${opts['dry-run'] ? 'would remove' : 'remove'}: ${target}`)
  if (opts['dry-run']) return
  if (!opts.yes) {
    if (!process.stdin.isTTY) fail('pass --yes to uninstall without a prompt')
    if (!(await confirm('remove these paths? [y/N] '))) {
      console.log('cancelled')
      return
    }
  }
  for (const target of targets) rmSync(target, { recursive: true, force: true })
  console.log('irsim removed')
}

const [command, ...rest] = process.argv.slice(2)
switch (command) {
  case 'serve':
    await serve(rest)
    break
  case 'build':
    await build(rest)
    break
  case 'export':
    await exportSite(rest)
    break
  case 'port': {
    const { port } = await canvasPort(projectRoot(process.cwd()))
    console.log(port)
    break
  }
  case 'thumbs':
    await thumbs(rest)
    break
  case 'init':
    init(rest)
    break
  case 'update':
    await update(rest)
    break
  case 'doctor':
    await doctor(rest)
    break
  case 'bridge': {
    const { runBridge } = await import(
      pathToFileURL(join(ROOT, 'bin', 'lib', 'bridge.mjs')).href
    )
    try {
      await runBridge(rest)
    } catch (error) {
      fail(error instanceof Error ? error.message : String(error), error?.exitCode ?? 1)
    }
    break
  }
  case 'uninstall':
    await uninstall(rest)
    break
  case 'version':
  case '--version':
    console.log(installedVersion())
    break
  case undefined:
  case '--help':
  case '-h':
  case 'help':
    process.stdout.write(HELP)
    break
  default:
    fail(`unknown command ${command}\n\n${HELP}`, 2)
}
