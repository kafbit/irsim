{
  "name": "irsim",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port $(bun scripts/canvas-port.ts)",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ public/runtime/ && (cd .. && oxlint bin/lib/export-site.mjs bin/lib/lint-design.mjs bin/lib/preview/)",
    "test": "bun test --isolate",
    "canvas:build": "node ../bin/irsim build",
    "canvas:thumbs": "bun scripts/thumbs.ts",
    "canvas:comments": "bun scripts/canvas-comments.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "^16.3.3",
    "playwright-core": "^1.65.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
